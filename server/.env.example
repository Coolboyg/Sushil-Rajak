# GharSaathi Backend Environment Variables
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Business Support Hotline
BUSINESS_SUPPORT_PHONE=8435423190

# Database (PostgreSQL / Prisma)
DATABASE_URL="postgresql://gharsaathi:gharsaathi_secret@localhost:5432/gharsaathi_db?schema=public"

# Redis for Distributed Availability & Dispatch Queues (optional)
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secret
JWT_SECRET="gharsaathi_super_secure_jwt_secret_key_2026"
JWT_EXPIRES_IN="7d"

# Razorpay / Payment Gateway Credentials
RAZORPAY_KEY_ID="rzp_test_sample_key_id"
RAZORPAY_KEY_SECRET="rzp_test_sample_key_secret"

# Commission Configuration (Default: 20%)
PLATFORM_COMMISSION_PERCENT=20
